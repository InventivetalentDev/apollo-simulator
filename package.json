{
  "name": "apollo-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Apollo 11 guidance computer simulator for the web, running the original Comanche055/Luminary099 source code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "assemble": "tsx scripts/assemble.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
